{
  "name": "yeonseo-math-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/index.js && node --check public/learning.js && node --check public/app.js && node --check public/parent.js",
    "dev": "wrangler dev",
    "db:local": "wrangler d1 migrations apply yeonseo-math --local",
    "db:remote": "wrangler d1 migrations apply yeonseo-math --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
